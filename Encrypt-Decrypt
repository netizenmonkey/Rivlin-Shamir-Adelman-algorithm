# Efficient modular exponentiation using binary method
def ModExp(m, e, N):
 
a = bin(e)[2:] # Convert e to binary
 
r = 1
 
t = m
 
for i in range(len(a) - 1, -1, -1):
 
if a[i] == '1':
 
r = (r * t) % N
 
t = (t * t) % N
 
return r
# Check if number is prime
def is_prime(n):
 
if n < 2:
 
return False
 
for i in range(2, int(n ** 0.5) + 1):
 
if n % i == 0:
 
return False
 
return True
